-
  const navLinks = [
    { name: "Topic A", href: "#topic-a" },
    { name: "Topic B", href: "#topic-b" },
    { name: "Topic C", href: "#topic-c" }
  ]

div.flex-space.nav-wrapper
  a(href="/") Book Library

  nav(aria-label="Main navigation")
    ul
      each link in navLinks
        li
          a(href=link.href)= link.name
